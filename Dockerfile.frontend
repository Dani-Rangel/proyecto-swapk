# Usa Node 20 (compatible con Next.js 15)
FROM node:20-alpine

# Directorio de trabajo
WORKDIR /app

# Copia solo package.json y lock
COPY frontend/package*.json ./

# Instala dependencias SIN caché
RUN npm install

# Copia el resto del código
COPY frontend/ .

# Verifica que eslint-config-next esté instalado
RUN ls node_modules/eslint-config-next || echo "eslint-config-next NOT FOUND"

# Construye la app
RUN npm run build

# Puerto
EXPOSE 3000

# Inicia
CMD ["npm", "start"]
